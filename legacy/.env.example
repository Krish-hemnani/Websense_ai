# Copy this file to a new file named ".env" (remove ".example") and paste
# your real key in. Never commit the real ".env" file to GitHub — that's
# exactly what .gitignore is for (see that file).

ANTHROPIC_API_KEY=sk-ant-your-real-key-here

# Optional — change which port the server runs on. Defaults to 3000 if unset.
PORT=3000
